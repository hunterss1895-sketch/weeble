DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"

# Provider: mock (default) | firsty | depinsim
# When unset, Firsty is auto-selected if credentials below are present.
PROVIDER="firsty"

# --- Firsty (recommended real provider) ---
# Free self-serve sandbox (no credit card): https://builders.firsty.app
# Or claim sandbox creds in one command: npx firsty init
# Docs: https://builders.firsty.app/esim-api  ·  https://developers.firsty.app/
#
# OAuth2 client credentials (preferred):
FIRSTY_CLIENT_ID="900111"
FIRSTY_CLIENT_SECRET="csk_35j1nqvmioe0ot6st9vx4dsygllrtk7o"
#
# Or paste a pre-minted JWT / bearer (shortcut):
# FIRSTY_API_KEY=
#
# Sandbox (default): https://connect.test.firsty.app/api/v3
# Production:        https://connect.firsty.app/api/v3
FIRSTY_API_BASE="https://connect.test.firsty.app/api/v3"
#
# Thin retail markup over Firsty per-MB wholesale (production cost model):
PRICE_MARKUP="1.35"
FIRSTY_WHOLESALE_CENTS_PER_MB="0.25"

# --- DepinSim (legacy / optional) ---
# DEPINSIM_ACCESS_TOKEN=
# DEPINSIM_API_BASE="https://api.depinsim.com/v1"
