DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"
# Public site URL (used for Secure cookie detection). Use http:// for IP:port deploys.
# AUTH_URL="http://45.33.15.93:3000"
# Force Secure cookie on/off (overrides AUTH_URL https check). For plain HTTP set false.
# AUTH_COOKIE_SECURE="false"

# Provider: mock (default) | esimcard | telnyx | firsty | depinsim
# When unset, eSIMCard is auto-selected if ESIMCARD_TOKEN is present (custom SPN reseller).
# Keep PROVIDER=mock until you have an eSIMCard partner API token.
PROVIDER="esimcard"

# --- eSIMCard (recommended — custom SPN reseller) ---
# Apply: https://esimcard.com/partners/  (NDA → API token)
# Free setup / pay when you sell. Enable Custom SPN in partner portal → Weeble.
# Sandbox: https://sandbox.esimcard.com/api/developer/
# Live:    https://portal.esimcard.com/api/developer/
# Auth: Authorization: Bearer <ESIMCARD_TOKEN>
# First GET check-token → extension; then base + extension + /
#
# ESIMCARD_TOKEN=
ESIMCARD_SANDBOX="true"
ESIMCARD_SPN="Weeble"
# Retail = wholesale × markup, snapped to $X.99 (full catalog):
# PRICE_MARKUP="2"
# ESIMCARD_WHOLESALE_CENTS_PER_MB="0.25"

# --- Telnyx (optional — custom SPN / whitelabel) ---
# Signup: https://telnyx.com  (paid account required to purchase eSIMs; trial cannot)
# TELNYX_API_KEY=
TELNYX_WHITELABEL_NAME="Weeble"
# WEEBLE_SPN="Weeble"
# TELNYX_SIM_CARD_GROUP_ID=
# TELNYX_API_BASE="https://api.telnyx.com/v2"

# --- Firsty (optional / legacy — api.firsty.app may 404) ---
# FIRSTY_CLIENT_ID=
# FIRSTY_CLIENT_SECRET=
# FIRSTY_API_BASE="https://api.firsty.app"
# PRICE_MARKUP="1.35"
# FIRSTY_WHOLESALE_CENTS_PER_MB="0.25"

# --- DepinSim (legacy / optional) ---
# DEPINSIM_ACCESS_TOKEN=
# DEPINSIM_API_BASE="https://api.depinsim.com/v1"
