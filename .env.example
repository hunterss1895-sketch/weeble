DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"

# Provider: mock (default) | firsty | depinsim
# When unset, Firsty is auto-selected if credentials below are present.
PROVIDER="mock"

# --- Firsty (recommended real provider) ---
# Official API: https://api.firsty.app
# Dashboard OAuth + bundles/sims:
#   POST /oauth/token  { grant_type, client_id, client_secret }
#   GET  /v1/bundles
#   POST /v1/sims  { bundle_id, customer_ref } + Idempotency-Key
#   POST /v1/sims/{id}/activate
#   GET  /v1/sims/{id}
#
# OAuth2 client credentials:
# FIRSTY_CLIENT_ID=
# FIRSTY_CLIENT_SECRET=
#
# FIRSTY_API_BASE="https://api.firsty.app"
#
# Thin retail markup over Firsty per-MB wholesale (production cost model):
# PRICE_MARKUP="1.35"
# FIRSTY_WHOLESALE_CENTS_PER_MB="0.25"

# --- DepinSim (legacy / optional) ---
# DEPINSIM_ACCESS_TOKEN=
# DEPINSIM_API_BASE="https://api.depinsim.com/v1"
