DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"
# Public site URL (used for Secure cookie detection). Use http:// for IP:port deploys.
# AUTH_URL="http://45.33.15.93:3000"
# Force Secure cookie on/off (overrides AUTH_URL https check). For plain HTTP set false.
# AUTH_COOKIE_SECURE="false"

# Provider: citrus (recommended) | mock | esimcard | telnyx | firsty | depinsim
# When unset, Citrus is auto-selected if CITRUS_API_KEY is present.
PROVIDER="citrus"

# --- Citrus Mobile Reseller API (pay-as-you-go) ---
# Docs: https://citrusmobile.com/developer/docs
# OpenAPI: https://citrusmobile.com/openapi-reseller.yaml
# Base: https://citrusmobile.com/api/v2/reseller
# Auth: Authorization: Bearer <CITRUS_API_KEY>
# CITRUS_API_KEY=rsk_...
# US storefront: 1/3/5/10/20/50/100 GB + Unlimited (~200 GB equiv fund, min $150).
# Wholesale fund = GB × live cheapest_per_gb_usd from GET /rates (US).
# Retail ≈ fund×PRICE_MARKUP + $1.75 provision (snapped to $X.99)
# PRICE_MARKUP="2"

# --- eSIMCard (legacy / optional — not used when PROVIDER=citrus) ---
# ESIMCARD_TOKEN=
# ESIMCARD_SANDBOX="true"
# ESIMCARD_SPN="Weeble"

# --- Telnyx (optional) ---
# TELNYX_API_KEY=
# TELNYX_WHITELABEL_NAME="Weeble"

# --- Firsty (optional / legacy) ---
# FIRSTY_CLIENT_ID=
# FIRSTY_CLIENT_SECRET=

# --- DepinSim (legacy / optional) ---
# DEPINSIM_ACCESS_TOKEN=
